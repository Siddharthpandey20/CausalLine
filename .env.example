# Copy to .env and fill in. .env is gitignored; never commit a real key.

# --- Gemini: the original scripted/live pipeline -----------------------------
GEMINI_API_KEY=your-key-here

# Optional. Defaults shown.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TEMPERATURE=0
# GEMINI_THINKING_LEVEL=minimal   # minimal | low | high
# GEMINI_MAX_OUTPUT_TOKENS=2048
# GEMINI_TIMEOUT_S=120   # generous on purpose: a retry costs a request (D-020)
# GEMINI_MAX_ATTEMPTS=5
# GEMINI_REQUESTS_PER_MINUTE=15   # free tier ceiling is 20/min; 0 disables pacing

# --- NVIDIA: the real-LLM evaluation (src/common/nvidia.py) ------------------
#
# Three keys, used ONE AT A TIME and in order. A key that answers 429 goes on a
# cooldown and the next one takes over; a key that answers 401/403 leaves the
# rotation for good. This is fallback for a campaign that must not die on one
# rate limit -- it is not a way of getting more throughput out of three
# accounts. One key is enough to run everything, just less resiliently.
NVIDIA_API_KEY_1=your-first-nvidia-key
NVIDIA_API_KEY_2=your-second-nvidia-key
NVIDIA_API_KEY_3=your-third-nvidia-key

# Optional. Defaults shown.
# NVIDIA_MODEL=nemotron          # nemotron | deepseek | minimax (see --models)
# NVIDIA_TEMPERATURE=0
# NVIDIA_MAX_OUTPUT_TOKENS=2048
# NVIDIA_TIMEOUT_S=300
# NVIDIA_MAX_ATTEMPTS=5
# NVIDIA_REQUESTS_PER_MINUTE=40  # 0 disables pacing
# NVIDIA_KEY_COOLDOWN_S=60       # how long a rate-limited key sits out
# NVIDIA_MODEL_COOLDOWN_S=900    # how long a failing model sits out; doubles per failure
# NVIDIA_MAX_CONCURRENCY=2       # whole tests in flight at once

# Check what is reachable without spending a campaign:
#   python -m src.common.nvidia --models
#   python -m src.common.nvidia --smoke
