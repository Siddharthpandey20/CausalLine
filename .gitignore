__pycache__/
*.py[cod]
.venv/
venv/
env/
.env
*.log
data/runs/
.vscode/
.DS_Store

# Generated by src/eval/economics.py and the campaign runner. Regenerable.
data/results/*.png
data/results/*.json
data/results/*.csv
!data/results/.gitkeep

# Generated real-LLM test suites and their runs. Regenerable, and large.
# Suites carry no credentials (tests assert this), but they are run output,
# not source, and the sample committed under data/samples/ is the one a reader
# needs.
data/generated/
data/results/real-llm*.json

# Build artefact from `pip install -e .`
*.egg-info/

# pytest cache
.pytest_cache/

# Industry-validation runs. A real campaign's artifacts are MEANT to be
# committed from the machine that produced them -- the mission requires results
# to live in the repository -- so only rehearsal runs are ignored here:
# anything marked `-stub`, and the two fixed ids the tests and dry runs use.
artifacts/industry_validation/*-stub/
artifacts/industry_validation/DRYRUN*/
artifacts/industry_validation/RESUMETEST/
artifacts/industry_validation/LATEST
